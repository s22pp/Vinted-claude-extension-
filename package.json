{
  "name": "era-intelligence",
  "description": "ERA Intelligence — cockpit de décision pour revendeurs Vinted",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test",
    "icons": "node scripts/build-icons.mjs",
    "release": "wxt build && rm -rf extension && cp -r .output/chrome-mv3 extension && wxt zip",
    "qa:screens": "wxt build && playwright test --config tests/visual/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
